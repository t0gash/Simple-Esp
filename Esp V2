local drawings = {}

local function createDrawingObjects(player)
    if drawings[player] then return drawings[player] end

    local objs = {
        boxOutline = Drawing.new("Square"),
        box = Drawing.new("Square"),
        healthBarOutline = Drawing.new("Square"),
        healthBarBg = Drawing.new("Square"),
        healthBar = Drawing.new("Square"),
        healthText = Drawing.new("Text"),
        tracer = Drawing.new("Line"),
        lookVector = Drawing.new("Line")
    }

    objs.boxOutline.Thickness = 3
    objs.boxOutline.Color = Color3.new(0, 0, 0)
    objs.box.Thickness = 1

    objs.healthBarOutline.Thickness = 1
    objs.healthBarOutline.Color = Color3.new(0, 0, 0)
    objs.healthBarBg.Thickness = 1
    objs.healthBarBg.Filled = true
    objs.healthBarBg.Color = Color3.fromRGB(20, 20, 20)
    objs.healthBar.Thickness = 1
    objs.healthBar.Filled = true

    objs.healthText.Size = 13
    objs.healthText.Center = true
    objs.healthText.Outline = true

    objs.tracer.Thickness = 1
    objs.lookVector.Thickness = 1.5

    drawings[player] = objs
    return objs
end

local function removeDrawingObjects(player)
    if drawings[player] then
        for _, obj in pairs(drawings[player]) do
            pcall(function() 
                obj.Visible = false
                obj:Remove() 
            end)
        end
        drawings[player] = nil
        visibilityCache[player] = nil
    end
end

local function clearPlayerESP(player)
    removeDrawingObjects(player)
    if player.Character then
        local hl = player.Character:FindFirstChild("ESPHighlight")
        if hl then hl:Destroy() end
        
        local head = player.Character:FindFirstChild("Head")
        if head then
            local bb = head:FindFirstChild("ESPBillboard")
            if bb then bb:Destroy() end
        end
    end
end

local function clearAllESP()
    for _, player in ipairs(Players:GetPlayers()) do
        clearPlayerESP(player)
    end
end

local function hideDrawings(drawObjs)
    for _, obj in pairs(drawObjs) do
        obj.Visible = false
    end
end

local function updateHighlightForPlayer(player)
    -- Если главный тумблер выключен, выходим моментально без вычислений
    if not config.espEnabled then return end

    if not player.Character then 
        clearPlayerESP(player)
        return 
    end

    local character = player.Character
    local head = character:FindFirstChild("Head")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if shouldHighlight(player) then
        local playerColor = getPlayerColor(player)

        -- Highlight 3D
        local highlight = character:FindFirstChild("ESPHighlight")
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "ESPHighlight"
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = character
        end
        
        highlight.FillColor = playerColor
        highlight.OutlineColor = Color3.fromRGB(0, 0, 0)
        highlight.FillTransparency = config.currentTransparency

        -- Billboard Text ESP
        local billboard = head and head:FindFirstChild("ESPBillboard")
        local hasText = config.showNameEnabled or config.showHealthEnabled or config.showDistanceEnabled
        if head and hasText then
            if not billboard then
                billboard = Instance.new("BillboardGui")
                billboard.Name = "ESPBillboard"
                billboard.Size = UDim2.new(0, 200, 0, 50)
                billboard.StudsOffset = Vector3.new(0, 3, 0)
                billboard.AlwaysOnTop = true
                billboard.Parent = head

                local textLabel = Instance.new("TextLabel")
                textLabel.Name = "InfoLabel"
                textLabel.Size = UDim2.new(1, 0, 1, 0)
                textLabel.BackgroundTransparency = 1
                textLabel.Font = Enum.Font.SourceSansBold
                textLabel.TextSize = 14
                textLabel.TextStrokeTransparency = 0
                textLabel.Parent = billboard
            end

            local infoLabel = billboard:FindFirstChild("InfoLabel")
            if infoLabel then
                local lines = {}
                if config.showNameEnabled then table.insert(lines, player.DisplayName) end
                if config.showHealthEnabled and humanoid then table.insert(lines, string.format("HP: %d", math.floor(humanoid.Health))) end
                if config.showDistanceEnabled then table.insert(lines, string.format("[%dm]", math.floor(getDistanceToPlayer(player)))) end
                
                infoLabel.Text = table.concat(lines, " | ")
                infoLabel.TextColor3 = playerColor
            end
        elseif billboard then
            billboard:Destroy()
        end

        -- 2D Drawing
        local drawObjs = createDrawingObjects(player)
        if rootPart and humanoid and humanoid.Health > 0 then
            local rootPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)

            if onScreen then
                local headPos = Camera:WorldToViewportPoint(head and head.Position + Vector3.new(0, 0.5, 0) or rootPart.Position + Vector3.new(0, 3, 0))
                local legPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3.5, 0))

                local height = math.abs(headPos.Y - legPos.Y)
                local width = height / 1.5
                local boxPos = Vector2.new(rootPos.X - width / 2, headPos.Y)

                -- Box ESP
                if config.boxEspEnabled then
                    drawObjs.boxOutline.Size = Vector2.new(width, height)
                    drawObjs.boxOutline.Position = boxPos
                    drawObjs.boxOutline.Visible = true

                    drawObjs.box.Size = Vector2.new(width, height)
                    drawObjs.box.Position = boxPos
                    drawObjs.box.Color = playerColor
                    drawObjs.box.Visible = true
                else
                    drawObjs.boxOutline.Visible = false
                    drawObjs.box.Visible = false
                end

                -- Healthbar
                if config.healthbarEnabled then
                    local healthPct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                    local barWidth = 3
                    local barPos = Vector2.new(boxPos.X - barWidth - 5, boxPos.Y)

                    drawObjs.healthBarOutline.Size = Vector2.new(barWidth + 2, height + 2)
                    drawObjs.healthBarOutline.Position = Vector2.new(barPos.X - 1, barPos.Y - 1)
                    drawObjs.healthBarOutline.Visible = true

                    drawObjs.healthBarBg.Size = Vector2.new(barWidth, height)
                    drawObjs.healthBarBg.Position = barPos
                    drawObjs.healthBarBg.Visible = true

                    local healthHeight = height * healthPct
                    local barY = barPos.Y + (height - healthHeight)
                    
                    drawObjs.healthBar.Size = Vector2.new(barWidth, healthHeight)
                    drawObjs.healthBar.Position = Vector2.new(barPos.X, barY)
                    drawObjs.healthBar.Color = Color3.new(math.clamp((1 - healthPct) * 2, 0, 1), math.clamp(healthPct * 2, 0, 1), 0)
                    drawObjs.healthBar.Visible = true

                    if healthPct < 0.98 then
                        drawObjs.healthText.Text = tostring(math.floor(humanoid.Health))
                        drawObjs.healthText.Position = Vector2.new(barPos.X - 10, barY - 2)
                        drawObjs.healthText.Visible = true
                    else
                        drawObjs.healthText.Visible = false
                    end
                else
                    drawObjs.healthBarOutline.Visible = false
                    drawObjs.healthBarBg.Visible = false
                    drawObjs.healthBar.Visible = false
                    drawObjs.healthText.Visible = false
                end

                -- Tracers
                if config.tracersEnabled then
                    drawObjs.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    drawObjs.tracer.To = Vector2.new(rootPos.X, rootPos.Y)
                    drawObjs.tracer.Color = playerColor
                    drawObjs.tracer.Visible = true
                else
                    drawObjs.tracer.Visible = false
                end

                -- Look Vector
                if config.lookVectorEnabled and head then
                    local lookTarget = head.CFrame.Position + (head.CFrame.LookVector * 6)
                    local targetScreen, lookOnScreen = Camera:WorldToViewportPoint(lookTarget)

                    if lookOnScreen then
                        local headScreen = Camera:WorldToViewportPoint(head.Position)
                        drawObjs.lookVector.From = Vector2.new(headScreen.X, headScreen.Y)
                        drawObjs.lookVector.To = Vector2.new(targetScreen.X, targetScreen.Y)
                        drawObjs.lookVector.Color = playerColor
                        drawObjs.lookVector.Visible = true
                    else
                        drawObjs.lookVector.Visible = false
                    end
                else
                    drawObjs.lookVector.Visible = false
                end
            else
                hideDrawings(drawObjs)
            end
        else
            hideDrawings(drawObjs)
        end
    else
        clearPlayerESP(player)
    end
end

local function updateAllESP()
    -- Полное отключение обработчика, если модуль отключен
    if not config.espEnabled then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then 
            updateHighlightForPlayer(player) 
        end
    end
end

