local function createGridToggleButton(text, configKey, parent, pos)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0.485, 0, 0, 26)
    button.Position = pos
    button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    button.Font = Enum.Font.SourceSansSemibold
    button.TextSize = 12
    button.Parent = parent

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 5)
    btnCorner.Parent = button

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Thickness = 1
    btnStroke.Parent = button

    addHoverEffect(button, Color3.fromRGB(30, 30, 30), Color3.fromRGB(45, 45, 45))

    local function updateState()
        if config[configKey] then
            button.Text = text .. ": ON"
            button.TextColor3 = Color3.fromRGB(255, 215, 0)
            btnStroke.Color = Color3.fromRGB(255, 200, 0)
        else
            button.Text = text .. ": OFF"
            button.TextColor3 = Color3.fromRGB(150, 150, 150)
            btnStroke.Color = Color3.fromRGB(60, 60, 60)
        end
    end

    updateState()

    button.MouseButton1Click:Connect(function()
        config[configKey] = not config[configKey]
        saveConfig()
        updateState()
        updateAllESP()
    end)

    return button
end

