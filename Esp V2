local isMenuOpen = true
local isAnimating = false

TweenService:Create(menuBlur, TweenInfo.new(0.25), {Size = 12}):Play()

local function toggleMenu()
    if isAnimating then return end
    isAnimating = true

    if isMenuOpen then
        playCustomSound(closeSound)
        TweenService:Create(menuBlur, TweenInfo.new(0.2), {Size = 0}):Play()
        
        local targetPos = UDim2.new(savedPosition.X.Scale, savedPosition.X.Offset, savedPosition.Y.Scale, savedPosition.Y.Offset + 30)
        local tweenPos = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = targetPos })
        local tweenSize = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(0, 340, 0, 0) })
        
        tweenPos:Play()
        tweenSize:Play()
        
        tweenSize.Completed:Connect(function()
            mainFrame.Visible = false
            isMenuOpen = false
            isAnimating = false
        end)
    else
        playCustomSound(openSound)
        TweenService:Create(menuBlur, TweenInfo.new(0.25), {Size = 12}):Play()
        
        mainFrame.Size = UDim2.new(0, 340, 0, 0)
        mainFrame.Position = UDim2.new(savedPosition.X.Scale, savedPosition.X.Offset, savedPosition.Y.Scale, savedPosition.Y.Offset + 30)
        mainFrame.Visible = true

        local tweenPos = TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = savedPosition })
        local tweenSize = TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0, 340, 0, 380) })

        tweenPos:Play()
        tweenSize:Play()

        tweenSize.Completed:Connect(function()
            isMenuOpen = true
            isAnimating = false
        end)
    end
end

closeBtn.MouseButton1Click:Connect(toggleMenu)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if isBindingKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            toggleKeyCode = input.KeyCode
            config.toggleKey = input.KeyCode.Name
            saveConfig()
            bindButton.Text = "Menu Keybind: [" .. config.toggleKey .. "]"
            bindButton.TextColor3 = Color3.fromRGB(255, 215, 0)
            task.delay(0.1, function() isBindingKey = false end)
        end
    elseif not gameProcessed and input.KeyCode == toggleKeyCode then
        toggleMenu()
    end
end)
