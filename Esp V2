local isSlidingTrans, isSlidingDist = false, false

local function updateTransSlider(input)
    local relX = input.Position.X - sliderBg.AbsolutePosition.X
    local scale = math.clamp(relX / sliderBg.AbsoluteSize.X, 0, 1)
    sliderFill.Size = UDim2.new(scale, 0, 1, 0)
    config.currentTransparency = scale
    transLabel.Text = string.format("Transparency: %d%%", math.floor(scale * 100))
    saveConfig()
    updateAllESP()
end

local function updateDistSlider(input)
    local relX = input.Position.X - distSliderBg.AbsolutePosition.X
    local scale = math.clamp(relX / distSliderBg.AbsoluteSize.X, 0, 1)
    distSliderFill.Size = UDim2.new(scale, 0, 1, 0)
    config.maxDistance = math.floor(minDistVal + scale * (maxDistVal - minDistVal))
    distLabel.Text = string.format("Max Distance: %dm", config.maxDistance)
    saveConfig()
    updateAllESP()
end

sliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isSlidingTrans = true
        updateTransSlider(input)
    end
end)

distSliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isSlidingDist = true
        updateDistSlider(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if isSlidingTrans then updateTransSlider(input) end
        if isSlidingDist then updateDistSlider(input) end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isSlidingTrans = false
        isSlidingDist = false
    end
end)

-- Открытие / Закрытие (С БЛЮРОМ)
local isMenuOpen = true
local isAnimating = false

-- Включаем блюр по умолчанию при запуске
TweenService:Create(menuBlur, TweenInfo.new(0.25), {Size = 12}):Play()

local function toggleMenu()
    if isAnimating then return end
    isAnimating = true

    if isMenuOpen then
        playCustomSound(closeSound)
        TweenService:Create(menuBlur, TweenInfo.new(0.2), {Size = 0}):Play()
        
        local targetPos = UDim2.new(savedPosition.X.Scale, savedPosition.X.Offset, savedPosition.Y.Scale, savedPosition.Y.Offset + 30)
        local tweenPos = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = targetPos })
        local tweenSize = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(0, 340, 0, 0) })
        
        tweenPos:Play()
        tweenSize:Play()
        
        tweenSize.Completed:Connect(function()
            mainFrame.Visible = false
            isMenuOpen = false
            isAnimating = false
        end)
    else
        playCustomSound(openSound)
        TweenService:Create(menuBlur, TweenInfo.new(0.25), {Size = 12}):Play()
        
        mainFrame.Size = UDim2.new(0, 340, 0, 0)
        mainFrame.Position = UDim2.new(savedPosition.X.Scale, savedPosition.X.Offset, savedPosition.Y.Scale, savedPosition.Y.Offset + 30)
        mainFrame.Visible = true

        local tweenPos = TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = savedPosition })
        local tweenSize = TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0, 340, 0, 380) })

        tweenPos:Play()
        tweenSize:Play()

        tweenSize.Completed:Connect(function()
            isMenuOpen = true
            isAnimating = false
        end)
    end
end

closeBtn.MouseButton1Click:Connect(toggleMenu)

