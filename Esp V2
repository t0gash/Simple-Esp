local drawings = {}

local function createDrawingObjects(player)
    if drawings[player] then return drawings[player] end

    local boxOutline = Drawing.new("Square")
    boxOutline.Visible = false
    boxOutline.Color = Color3.new(0, 0, 0)
    boxOutline.Thickness = 3
    boxOutline.Filled = false

    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.new(1, 1, 1)
    box.Thickness = 1
    box.Filled = false

    local healthBarOutline = Drawing.new("Square")
    healthBarOutline.Visible = false
    healthBarOutline.Color = Color3.new(0, 0, 0)
    healthBarOutline.Thickness = 1
    healthBarOutline.Filled = false

    local healthBarBg = Drawing.new("Square")
    healthBarBg.Visible = false
    healthBarBg.Color = Color3.fromRGB(20, 20, 20)
    healthBarBg.Thickness = 1
    healthBarBg.Filled = true

    local healthBar = Drawing.new("Square")
    healthBar.Visible = false
    healthBar.Color = Color3.new(0, 1, 0)
    healthBar.Thickness = 1
    healthBar.Filled = true

    local healthText = Drawing.new("Text")
    healthText.Visible = false
    healthText.Color = Color3.new(1, 1, 1)
    healthText.Size = 13
    healthText.Center = true
    healthText.Outline = true
    healthText.OutlineColor = Color3.new(0, 0, 0)

    local tracer = Drawing.new("Line")
    tracer.Visible = false
    tracer.Color = Color3.new(1, 1, 1)
    tracer.Thickness = 1

    local lookVector = Drawing.new("Line")
    lookVector.Visible = false
    lookVector.Color = Color3.fromRGB(255, 50, 50)
    lookVector.Thickness = 1.5

    drawings[player] = {
        boxOutline = boxOutline,
        box = box,
        healthBarOutline = healthBarOutline,
        healthBarBg = healthBarBg,
        healthBar = healthBar,
        healthText = healthText,
        tracer = tracer,
        lookVector = lookVector
    }

    return drawings[player]
end

local function removeDrawingObjects(player)
    if drawings[player] then
        local data = drawings[player]
        pcall(function() data.boxOutline:Remove() end)
        pcall(function() data.box:Remove() end)
        pcall(function() data.healthBarOutline:Remove() end)
        pcall(function() data.healthBarBg:Remove() end)
        pcall(function() data.healthBar:Remove() end)
        pcall(function() data.healthText:Remove() end)
        pcall(function() data.tracer:Remove() end)
        pcall(function() data.lookVector:Remove() end)
        drawings[player] = nil
    end
end

local function hideDrawings(drawObjs)
    drawObjs.boxOutline.Visible = false
    drawObjs.box.Visible = false
    drawObjs.healthBarOutline.Visible = false
    drawObjs.healthBarBg.Visible = false
    drawObjs.healthBar.Visible = false
    drawObjs.healthText.Visible = false
    drawObjs.tracer.Visible = false
    drawObjs.lookVector.Visible = false
end

local function updateHighlightForPlayer(player)
    if not player.Character then 
        removeDrawingObjects(player)
        return 
    end

    local character = player.Character
    local head = character:FindFirstChild("Head")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    local highlight = character:FindFirstChild("ESPHighlight")
    local billboard = head and head:FindFirstChild("ESPBillboard")
    local drawObjs = createDrawingObjects(player)

    if shouldHighlight(player) then
        local playerColor = getPlayerColor(player)

        -- Highlight 3D
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "ESPHighlight"
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = character
        end
        
        highlight.FillColor = playerColor
        highlight.OutlineColor = Color3.fromRGB(0, 0, 0)
        highlight.FillTransparency = config.currentTransparency
        highlight.OutlineTransparency = 0
        highlight.Adornee = character

        -- Billboard Text ESP
        local hasAnyTextOption = config.showNameEnabled or config.showHealthEnabled or config.showDistanceEnabled

        if head and hasAnyTextOption then
            if not billboard then
                billboard = Instance.new("BillboardGui")
                billboard.Name = "ESPBillboard"
                billboard.Size = UDim2.new(0, 200, 0, 50)
                billboard.StudsOffset = Vector3.new(0, 3, 0)
                billboard.AlwaysOnTop = true
                billboard.Parent = head

                local textLabel = Instance.new("TextLabel")
                textLabel.Name = "InfoLabel"
                textLabel.Size = UDim2.new(1, 0, 1, 0)
                textLabel.BackgroundTransparency = 1
                textLabel.Font = Enum.Font.SourceSansBold
                textLabel.TextSize = 14
                textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                textLabel.TextStrokeTransparency = 0
                textLabel.Parent = billboard
            end

            local infoLabel = billboard:FindFirstChild("InfoLabel")
            if infoLabel then
                local lines = {}

                if config.showNameEnabled then
                    local teamName = player.Team and (" [" .. player.Team.Name .. "]") or ""
                    table.insert(lines, player.DisplayName .. teamName)
                end

                if config.showHealthEnabled and humanoid then
                    local health = math.floor(humanoid.Health)
                    local maxHealth = math.floor(humanoid.MaxHealth)
                    table.insert(lines, string.format("HP: %d/%d", health, maxHealth))
                end

                if config.showDistanceEnabled then
                    local dist = math.floor(getDistanceToPlayer(player))
                    if dist ~= math.huge then
                        table.insert(lines, string.format("[%dm]", dist))
                    end
                end

                infoLabel.Text = table.concat(lines, " | ")
                infoLabel.TextColor3 = playerColor
            end
        else
            if billboard then billboard:Destroy() end
        end

        -- 2D Drawing
        if rootPart and humanoid and humanoid.Health > 0 then
            local rootPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)

            if onScreen then
                local headPos = Camera:WorldToViewportPoint(head and head.Position + Vector3.new(0, 0.5, 0) or rootPart.Position + Vector3.new(0, 3, 0))
                local legPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3.5, 0))

                local height = math.abs(headPos.Y - legPos.Y)
                local width = height / 1.5
                local boxPos = Vector2.new(rootPos.X - width / 2, headPos.Y)

                -- Box ESP
                if config.boxEspEnabled then
                    drawObjs.boxOutline.Size = Vector2.new(width, height)
                    drawObjs.boxOutline.Position = boxPos
                    drawObjs.boxOutline.Visible = true

                    drawObjs.box.Size = Vector2.new(width, height)
                    drawObjs.box.Position = boxPos
                    drawObjs.box.Color = playerColor
                    drawObjs.box.Visible = true
                else
                    drawObjs.boxOutline.Visible = false
                    drawObjs.box.Visible = false
                end

                -- Healthbar
                if config.healthbarEnabled then
                    local healthPct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                    local barWidth = 3
                    local barPos = Vector2.new(boxPos.X - barWidth - 5, boxPos.Y)

                    drawObjs.healthBarOutline.Size = Vector2.new(barWidth + 2, height + 2)
                    drawObjs.healthBarOutline.Position = Vector2.new(barPos.X - 1, barPos.Y - 1)
                    drawObjs.healthBarOutline.Visible = true

                    drawObjs.healthBarBg.Size = Vector2.new(barWidth, height)
                    drawObjs.healthBarBg.Position = barPos
                    drawObjs.healthBarBg.Visible = true

                    local healthHeight = height * healthPct
                    local barY = barPos.Y + (height - healthHeight)
                    
                    drawObjs.healthBar.Size = Vector2.new(barWidth, healthHeight)
                    drawObjs.healthBar.Position = Vector2.new(barPos.X, barY)
                    
                    local r = math.clamp((1 - healthPct) * 2, 0, 1)
                    local g = math.clamp(healthPct * 2, 0, 1)
                    drawObjs.healthBar.Color = Color3.new(r, g, 0)
                    drawObjs.healthBar.Visible = true

                    if healthPct < 0.98 then
                        drawObjs.healthText.Text = tostring(math.floor(humanoid.Health))
                        drawObjs.healthText.Position = Vector2.new(barPos.X - 10, barY - 2)
                        drawObjs.healthText.Color = Color3.fromRGB(255, 255, 255)
                        drawObjs.healthText.Visible = true
                    else
                        drawObjs.healthText.Visible = false
                    end
                else
                    drawObjs.healthBarOutline.Visible = false
                    drawObjs.healthBarBg.Visible = false
                    drawObjs.healthBar.Visible = false
                    drawObjs.healthText.Visible = false
                end

                -- Tracer Lines
                if config.tracersEnabled then
                    drawObjs.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    drawObjs.tracer.To = Vector2.new(rootPos.X, rootPos.Y)
                    drawObjs.tracer.Color = playerColor
                    drawObjs.tracer.Visible = true
                else
                    drawObjs.tracer.Visible = false
                end

                -- Look Vector
                if config.lookVectorEnabled and head then
                    local headCFrame = head.CFrame
                    local lookTarget = headCFrame.Position + (headCFrame.LookVector * 6)
                    local targetScreen, lookOnScreen = Camera:WorldToViewportPoint(lookTarget)

                    if lookOnScreen then
                        local headScreen = Camera:WorldToViewportPoint(head.Position)
                        drawObjs.lookVector.From = Vector2.new(headScreen.X, headScreen.Y)
                        drawObjs.lookVector.To = Vector2.new(targetScreen.X, targetScreen.Y)
                        drawObjs.lookVector.Color = playerColor
                        drawObjs.lookVector.Visible = true
                    else
                        drawObjs.lookVector.Visible = false
                    end
                else
                    drawObjs.lookVector.Visible = false
                end
            else
                hideDrawings(drawObjs)
            end
        else
            hideDrawings(drawObjs)
        end
    else
        if highlight then highlight:Destroy() end
        if billboard then billboard:Destroy() end
        removeDrawingObjects(player)
    end
end

local function updateAllESP()
    for _, player in ipairs(Players:GetPlayers()) do
